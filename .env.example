# TikTok Auto Poster Environment Variables (Optional overrides)

# Posting Interval Range in minutes (default: random 40 - 60 minutes)
INTERVAL_MIN_MINUTES=40
INTERVAL_MAX_MINUTES=60
DEFAULT_INTERVAL_MINUTES=45

# Headless mode for background posting (true / false)
HEADLESS=false

# Browser Channel: "chrome" (recommended) or "chromium"
BROWSER_CHANNEL=chrome

# Default Post Visibility: Public, Friends, Private
DEFAULT_VISIBILITY=Public

# Caption Theme: general, tech, crypto, affiliate, motivational
CAPTION_THEME=general

# Optional: Token or Product Name for Caption Generator
TOKEN_OR_PRODUCT_NAME=$MYTOKEN
CONTRACT_ADDRESS_OR_LINK=0x0000000000000000000000000000000000000000
